native-vm-env/
├── package.json              # 项目配置与依赖管理
├── package-lock.json
├── .gitignore                # Git忽略文件
├── README.md                 # 项目说明文档
├── index.js                  # 框架入口文件（对外暴露所有API）
├── core/                     # 核心基础层（不可轻易修改）
│   ├── vm-context.js         # VM上下文封装（最核心）
│   ├── context-pool.js       # 上下文池与生命周期管理
│   └── sandbox.js            # 沙箱安全加固（可选扩展）
├── env/                      # 环境模拟层（主要扩展点）
│   ├── browser-env.js        # 基础浏览器环境实现
│   ├── dom/                  # DOM相关API实现
│   │   ├── document.js       # Document对象完整实现
│   │   ├── element.js        # Element基类
│   │   ├── node.js           # Node基类
│   │   └── style.js          # CSS样式相关
│   ├── bom/                  # BOM相关API实现
│   │   ├── navigator.js      # Navigator对象
│   │   ├── location.js       # Location对象
│   │   ├── history.js        # History对象
│   │   └── screen.js         # Screen对象
│   └── network/              # 网络相关API实现
│       ├── xhr.js            # XMLHttpRequest完整实现
│       ├── fetch.js          # Fetch API实现
│       └── websocket.js      # WebSocket实现
├── plugins/                  # 插件系统（可插拔扩展）
│   ├── anti-detect/          # 反检测插件集合
│   │   ├── prototype-fix.js  # 原型链与toString修复
│   │   ├── error-stack.js    # 浏览器错误栈模拟
│   │   ├── performance.js    # Performance API模拟
│   │   └── fingerprint.js    # 浏览器指纹随机化
│   ├── debugger/             # 调试工具插件
│   │   ├── api-trace.js      # API调用追踪
│   │   ├── code-logger.js    # 代码执行日志
│   │   └── snapshot.js       # 环境快照与恢复
│   └── utils/                # 通用工具插件
│       ├── cookie.js         # Cookie管理
│       ├── storage.js        # localStorage/sessionStorage
│       └── canvas.js         # Canvas API模拟
├── utils/                    # 通用工具函数
│   ├── native-utils.js       # 原生函数伪装工具
│   ├── object-utils.js       # 对象操作工具
│   └── string-utils.js       # 字符串处理工具
├── examples/                 # 使用示例
│   ├── basic-usage.js        # 基础使用示例
│   ├── encrypt-call.js       # 加密函数调用示例
│   ├── plugin-usage.js       # 插件使用示例
│   └── pool-usage.js         # 上下文池使用示例
├── test/                     # 单元测试
│   ├── core/                 # 核心模块测试
│   ├── env/                  # 环境模拟测试
│   └── plugins/              # 插件测试
└── config/                   # 配置文件目录
    ├── default.js            # 默认配置
    ├── chrome-125.js         # Chrome 125环境配置
    ├── firefox-126.js        # Firefox 126环境配置
    └── mobile-chrome.js      # 移动端Chrome配置



